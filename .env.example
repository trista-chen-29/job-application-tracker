DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=America/Los_Angeles
# Leave empty to use SQLite. Example: postgres://user:pass@localhost:5432/jobtracker
DATABASE_URL=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must match the Google Cloud OAuth client redirect URI exactly.
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8002/gmail/callback/
# Optional: the Google Sheet the web app writes to (internships / newgrad tabs).
GOOGLE_SHEET_ID=
